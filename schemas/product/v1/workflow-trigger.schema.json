{
  "$defs": {
    "WorkflowTriggerStatus": {
      "enum": [
        "active",
        "disabled"
      ],
      "title": "WorkflowTriggerStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A secret-authenticated webhook bound to a published workflow.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by_principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Created By Principal Id",
      "type": "string"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "secret_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "Secret Digest",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/WorkflowTriggerStatus"
    },
    "task_instructions": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Task Instructions",
      "type": "string"
    },
    "trigger_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Trigger Id",
      "type": "string"
    },
    "trigger_type": {
      "const": "webhook",
      "default": "webhook",
      "title": "Trigger Type",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "workflow_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workflow Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "workspace_id",
    "trigger_id",
    "workflow_id",
    "created_by_principal_id",
    "name",
    "task_instructions",
    "secret_digest",
    "status"
  ],
  "title": "WorkflowTrigger",
  "type": "object"
}
