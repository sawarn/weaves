          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Run Cost Usd"
    },
    "max_runtime_seconds": {
      "default": 300,
      "maximum": 3600,
      "minimum": 1,
      "title": "Max Runtime Seconds",
      "type": "integer"
    },
    "max_tool_calls": {
      "default": 10,
      "maximum": 100,
      "minimum": 0,
      "title": "Max Tool Calls",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "AgentBudget",
  "type": "object"
