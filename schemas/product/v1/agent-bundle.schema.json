{
  "$defs": {
    "AgentBudget": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "default": 4096,
          "maximum": 32768,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_run_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Run Cost Usd"
        },
        "max_runtime_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Runtime Seconds",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "title": "AgentBudget",
      "type": "object"
    },
    "AgentDefinition": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "current_version_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Version Id"
        },
        "description": {
          "default": "",
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "org_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/AgentStatus"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "org_id",
        "workspace_id",
        "id",
        "name",
        "status"
      ],
      "title": "AgentDefinition",
      "type": "object"
    },
    "AgentStatus": {
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "title": "AgentStatus",
      "type": "string"
    },
    "AgentVersion": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Version Id",
          "type": "string"
        },
        "allowed_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Allowed Capability Ids",
          "type": "array"
        },
        "allowed_workflow_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Allowed Workflow Ids",
          "type": "array"
        },
        "approval_policy_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Policy Id"
        },
        "budget": {
          "$ref": "#/$defs/AgentBudget"
        },
        "budget_policy_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Policy Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "instructions": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "memory_policy": {
          "$ref": "#/$defs/MemoryPolicy"
        },
        "model_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Profile Id",
          "type": "string"
        },
        "org_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "persona": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Persona",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "org_id",
        "workspace_id",
        "agent_version_id",
        "agent_id",
        "version",
        "persona",
        "instructions",
        "model_profile_id"
      ],
      "title": "AgentVersion",
      "type": "object"
    },
    "JsonValue": {},
    "MemoryPolicy": {
      "additionalProperties": false,
      "description": "Scopes an agent may retrieve during a run; defaults to workspace memory.",
      "properties": {
        "allowed_scopes": {
          "default": [
            "workspace"
          ],
          "items": {
            "$ref": "#/$defs/MemoryScope"
          },
          "title": "Allowed Scopes",
          "type": "array"
        },
        "max_items": {
          "default": 8,
          "maximum": 50,
          "minimum": 0,
          "title": "Max Items",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "title": "MemoryPolicy",
      "type": "object"
    },
    "MemoryScope": {
      "enum": [
        "none",
        "thread",
        "workflow",
        "workspace",
        "organization"
      ],
      "title": "MemoryScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Resolved agent definition/version pair with scope and pointer checks.",
  "properties": {
    "definition": {
      "$ref": "#/$defs/AgentDefinition"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "$ref": "#/$defs/AgentVersion"
    }
  },
  "required": [
    "definition",
    "version"
  ],
  "title": "AgentBundle",
  "type": "object"
}
