{
  "$defs": {
    "JsonValue": {},
    "PluginInstallationStatus": {
      "enum": [
        "active",
        "disabled",
        "error"
      ],
      "title": "PluginInstallationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "auth_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Auth Ref"
    },
    "configuration": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Configuration",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "display_name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "enabled_capability_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "maxItems": 200,
      "title": "Enabled Capability Ids",
      "type": "array"
    },
    "last_healthcheck_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Healthcheck At"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "plugin_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Plugin Id",
      "type": "string"
    },
    "plugin_installation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Plugin Installation Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/PluginInstallationStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "workspace_id",
    "plugin_installation_id",
    "plugin_id",
    "display_name",
    "status"
  ],
  "title": "PluginInstallation",
  "type": "object"
}
