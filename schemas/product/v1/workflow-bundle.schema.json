{
  "$defs": {
    "JsonValue": {},
    "WorkflowDefinition": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "current_version_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Version Id"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "org_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/WorkflowStatus"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "workflow_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "org_id",
        "workspace_id",
        "workflow_id",
        "name",
        "status"
      ],
      "title": "WorkflowDefinition",
      "type": "object"
    },
    "WorkflowStatus": {
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "title": "WorkflowStatus",
      "type": "string"
    },
    "WorkflowVersion": {
      "additionalProperties": false,
      "properties": {
        "agent_version_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Agent Version Ids",
          "type": "array"
        },
        "configuration": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Configuration",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "handler_key": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Handler Key",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "org_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output Schema",
          "type": "object"
        },
        "required_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Required Capability Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "workflow_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        },
        "workflow_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workflow Version Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "org_id",
        "workspace_id",
        "workflow_version_id",
        "workflow_id",
        "version",
        "handler_key",
        "agent_version_ids",
        "input_schema",
        "output_schema"
      ],
      "title": "WorkflowVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "definition": {
      "$ref": "#/$defs/WorkflowDefinition"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "$ref": "#/$defs/WorkflowVersion"
    }
  },
  "required": [
    "definition",
    "version"
  ],
  "title": "WorkflowBundle",
  "type": "object"
}
