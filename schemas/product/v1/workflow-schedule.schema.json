{
  "$defs": {
    "ErrorSummary": {
      "additionalProperties": false,
      "description": "Bounded user-safe error details; stack traces and provider payloads do not belong here.",
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "title": "ErrorSummary",
      "type": "object"
    },
    "WorkflowScheduleStatus": {
      "enum": [
        "active",
        "disabled",
        "error"
      ],
      "title": "WorkflowScheduleStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A recurring interval schedule bound to a workflow and its creator.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by_principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Created By Principal Id",
      "type": "string"
    },
    "interval_seconds": {
      "maximum": 31536000,
      "minimum": 60,
      "title": "Interval Seconds",
      "type": "integer"
    },
    "last_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "last_run_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Run At"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "next_run_at": {
      "format": "date-time",
      "title": "Next Run At",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "schedule_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Schedule Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/WorkflowScheduleStatus"
    },
    "task_instructions": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Task Instructions",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "workflow_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workflow Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "workspace_id",
    "schedule_id",
    "workflow_id",
    "created_by_principal_id",
    "name",
    "task_instructions",
    "interval_seconds",
    "status",
    "next_run_at"
  ],
  "title": "WorkflowSchedule",
  "type": "object"
}
