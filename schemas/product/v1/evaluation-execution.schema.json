{
  "$defs": {
    "ErrorSummary": {
      "additionalProperties": false,
      "description": "Bounded user-safe error details; stack traces and provider payloads do not belong here.",
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "title": "ErrorSummary",
      "type": "object"
    },
    "EvaluationCase": {
      "additionalProperties": false,
      "description": "One task and its deterministic acceptance checks.",
      "properties": {
        "case_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "minimum_tool_calls": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Minimum Tool Calls",
          "type": "integer"
        },
        "must_contain": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Must Contain",
          "type": "array"
        },
        "must_not_contain": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Must Not Contain",
          "type": "array"
        },
        "required_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Required Sources",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "task": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "task"
      ],
      "title": "EvaluationCase",
      "type": "object"
    },
    "EvaluationCaseResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/EvaluationCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,6}|(?=[\\d.]{1,19}0*$)\\d{0,6}\\.\\d{0,12}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "passed",
        "checks"
      ],
      "title": "EvaluationCaseResult",
      "type": "object"
    },
    "EvaluationCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "passed",
        "detail"
      ],
      "title": "EvaluationCheck",
      "type": "object"
    },
    "EvaluationExecutionStatus": {
      "enum": [
        "queued",
        "running",
        "cancel_requested",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "EvaluationExecutionStatus",
      "type": "string"
    },
    "EvaluationSuite": {
      "additionalProperties": false,
      "description": "Versioned, portable set of representative agent tasks.",
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/EvaluationCase"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "suite_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Suite Id",
          "type": "string"
        }
      },
      "required": [
        "suite_id",
        "agent_id",
        "cases"
      ],
      "title": "EvaluationSuite",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Durable progress for a queued evaluation suite execution.",
  "properties": {
    "agent_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/EvaluationSuite"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Evaluation Id",
      "type": "string"
    },
    "execution_job_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Execution Job Id",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "requested_by_principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Requested By Principal Id",
      "type": "string"
    },
    "results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvaluationCaseResult"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/EvaluationExecutionStatus"
    },
    "suite_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Suite Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "workspace_id",
    "evaluation_id",
    "suite_id",
    "agent_id",
    "execution_job_id",
    "requested_by_principal_id",
    "definition",
    "status"
  ],
  "title": "EvaluationExecution",
  "type": "object"
}
