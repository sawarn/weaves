{
  "$defs": {
    "ModelProfileStatus": {
      "enum": [
        "active",
        "disabled"
      ],
      "title": "ModelProfileStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cost_budget_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 100000.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Budget Usd"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "default_temperature": {
      "default": 0.2,
      "maximum": 2.0,
      "minimum": 0.0,
      "title": "Default Temperature",
      "type": "number"
    },
    "display_name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "fallback_model_profile_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Model Profile Id"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "input_cost_per_million_tokens_usd": {
      "anyOf": [
        {
          "maximum": 100000.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,9}|(?=[\\d.]{1,19}0*$)\\d{0,9}\\.\\d{0,9}0*$)",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Cost Per Million Tokens Usd"
    },
    "max_output_tokens": {
      "default": 2048,
      "maximum": 32768,
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "model": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "title": "Model",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "output_cost_per_million_tokens_usd": {
      "anyOf": [
        {
          "maximum": 100000.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,9}|(?=[\\d.]{1,19}0*$)\\d{0,9}\\.\\d{0,9}0*$)",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Cost Per Million Tokens Usd"
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ModelProfileStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "id",
    "provider_id",
    "model",
    "display_name",
    "status"
  ],
  "title": "ModelProfile",
  "type": "object"
}
