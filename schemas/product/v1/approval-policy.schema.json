{
  "$defs": {
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Workspace policy deciding which capability risks require human review.",
  "properties": {
    "allow_self_approval": {
      "default": false,
      "title": "Allow Self Approval",
      "type": "boolean"
    },
    "approval_policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Approval Policy Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "required_risk_levels": {
      "default": [
        "medium",
        "high",
        "critical"
      ],
      "items": {
        "$ref": "#/$defs/RiskLevel"
      },
      "maxItems": 4,
      "title": "Required Risk Levels",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "workspace_id",
    "approval_policy_id",
    "name"
  ],
  "title": "ApprovalPolicy",
  "type": "object"
}
