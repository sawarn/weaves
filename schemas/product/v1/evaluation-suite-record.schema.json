{
  "$defs": {
    "EvaluationCase": {
      "additionalProperties": false,
      "description": "One task and its deterministic acceptance checks.",
      "properties": {
        "case_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "minimum_tool_calls": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Minimum Tool Calls",
          "type": "integer"
        },
        "must_contain": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Must Contain",
          "type": "array"
        },
        "must_not_contain": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Must Not Contain",
          "type": "array"
        },
        "required_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Required Sources",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "task": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "task"
      ],
      "title": "EvaluationCase",
      "type": "object"
    },
    "EvaluationSuite": {
      "additionalProperties": false,
      "description": "Versioned, portable set of representative agent tasks.",
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/EvaluationCase"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "suite_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Suite Id",
          "type": "string"
        }
      },
      "required": [
        "suite_id",
        "agent_id",
        "cases"
      ],
      "title": "EvaluationSuite",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Workspace-owned, editable evaluation definition.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by_principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Created By Principal Id",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/EvaluationSuite"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "suite_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Suite Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "updated_by_principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Updated By Principal Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "workspace_id",
    "suite_id",
    "definition",
    "created_by_principal_id",
    "updated_by_principal_id"
  ],
  "title": "EvaluationSuiteRecord",
  "type": "object"
}
