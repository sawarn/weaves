{
  "additionalProperties": false,
  "properties": {
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_ref": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Ref",
      "type": "string"
    },
    "source_type": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Type",
      "type": "string"
    }
  },
  "required": [
    "source_type",
    "source_ref",
    "recorded_at"
  ],
  "title": "ArtifactProvenance",
  "type": "object"
}
