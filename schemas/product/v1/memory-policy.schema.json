{
  "$defs": {
    "MemoryScope": {
      "enum": [
        "none",
        "thread",
        "workflow",
        "workspace",
        "organization"
      ],
      "title": "MemoryScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Scopes an agent may retrieve during a run; defaults to workspace memory.",
  "properties": {
    "allowed_scopes": {
      "default": [
        "workspace"
      ],
      "items": {
        "$ref": "#/$defs/MemoryScope"
      },
      "title": "Allowed Scopes",
      "type": "array"
    },
    "max_items": {
      "default": 8,
      "maximum": 50,
      "minimum": 0,
      "title": "Max Items",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "MemoryPolicy",
  "type": "object"
}
