# Optional environment-configured provider. The API remains the preferred way
# to register multiple providers and model profiles.
MODEL_PROVIDER_TYPE=openai
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini

# Required to save provider API keys in PostgreSQL mode. Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
WEAVES_SECRET_ENCRYPTION_KEY=

# Optional legacy bearer token for the local developer principal.
WEAVES_API_TOKEN=

# Optional principal-bound bearer tokens. When configured, product routes
# require a matching token and its principal must be active in the local org.
# Keep tokens in a secret manager; rotate by updating this setting and restarting.
WEAVES_API_TOKENS=

# Product worker queue poll frequency (seconds).
WEAVES_WORKER_POLL_SECONDS=1

# MCP servers are disabled until explicitly allowed by hostname.
# Comma-separated exact hostnames; MCP connections require HTTPS on port 443.
WEAVES_MCP_ALLOWED_HOSTS=

# Browser OAuth connector setup. Use Secret Manager for deployed environments.
WEAVES_PUBLIC_API_BASE_URL=
WEAVES_PUBLIC_FRONTEND_URL=https://app.weave-studio.in
WEAVES_GITHUB_APP_ID=
WEAVES_GITHUB_APP_SLUG=
WEAVES_GITHUB_APP_CLIENT_ID=
WEAVES_GITHUB_APP_CLIENT_SECRET=
WEAVES_GITHUB_APP_PRIVATE_KEY=
WEAVES_SLACK_OAUTH_CLIENT_ID=
WEAVES_SLACK_OAUTH_CLIENT_SECRET=
WEAVES_ATLASSIAN_OAUTH_CLIENT_ID=
WEAVES_ATLASSIAN_OAUTH_CLIENT_SECRET=

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
